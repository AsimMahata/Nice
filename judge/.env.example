PORT=5001
EXECUTION_PROVIDER=auto
ONLINE_JUDGE_PROVIDER=jdoodle

# Docker Worker Pool Configuration
JUDGE_WORKERS=2
JUDGE_WORKER_MEMORY_MB=100
JUDGE_WORKER_CPUS=1.0
JUDGE_WORKER_PIDS_LIMIT=128
JUDGE_MAX_QUEUE_SIZE=20
JUDGE_EXECUTION_TIMEOUT_MS=5000
JUDGE_DOCKER_IMAGE=nice-judge-runner:latest
JUDGE_CONTAINER_PREFIX=nice-worker

# JDoodle / Online Judge Configuration (Fallback)
JDOODLE_CLIENT_ID=
JDOODLE_CLIENT_SECRET=
JDOODLE_API_URL=https://api.jdoodle.com/v1/execute
